#!/bin/bash
# Sketchybar - Catppuccin Mocha + Aerospace

PLUGIN_DIR="$CONFIG_DIR/plugins"

BAR_COLOR=0xff1e1e2e
ACTIVE_BG=0xff89b4fa
ACTIVE_FG=0xff1e1e2e
SUBTEXT=0xffbac2de

##### Bar #####
sketchybar --bar \
  position=bottom \
  height=36 \
  color=$BAR_COLOR \
  border_width=1 \
  border_color=0xff313244 \
  display=all \
  padding_left=8 \
  padding_right=8 \
  shadow=off

##### Defaults #####
sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Bold:13.0" \
  label.drawing=off \
  icon.color=$SUBTEXT \
  icon.padding_left=8 \
  icon.padding_right=8 \
  background.corner_radius=0 \
  background.height=30 \
  background.drawing=on \
  background.color=0x00000000 \
  padding_left=4 \
  padding_right=4

##### Aerospace event #####
sketchybar --add event aerospace_workspace_change

##### Workspaces (iguales en todos los monitores) #####
# Laptop: 9 0 | Samsung: 1 2 3 4 | LG: 5 6 7 8
add_space() {
  local sid="$1" label="$1"
  [ "$sid" = "10" ] && label="0"
  sketchybar --add item space.$sid center \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
      icon="$label" \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
}

add_separator() {
  sketchybar --add item "$1" center \
    --set "$1" icon="|" icon.color=0xff45475a \
      icon.padding_left=2 icon.padding_right=2
}

for sid in 9 10; do add_space $sid; done
add_separator sep.laptop
for sid in 1 2 3 4; do add_space $sid; done
add_separator sep.samsung
for sid in 5 6 7 8; do add_space $sid; done

sketchybar --update

# Trigger initial state con el workspace activo actual
CURRENT=$(aerospace list-workspaces --focused 2>/dev/null)
[ -n "$CURRENT" ] && sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$CURRENT"
